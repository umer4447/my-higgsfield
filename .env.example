# Copy to .env. Every value is validated at boot by app/config.py — a bad or
# missing value crashes the process at import rather than at the first request.

ENVIRONMENT=dev

# Runtime uses the POOLED endpoint (PgBouncer / Neon). Migrations use the
# direct one. See architecture.md §16 — an unpooled Postgres behind a
# serverless app exhausts connections at trivial load.
DATABASE_URL=postgresql://darkroom:darkroom@localhost:5432/darkroom_dev
DIRECT_DATABASE_URL=postgresql://darkroom:darkroom@localhost:5432/darkroom_dev
TEST_DATABASE_URL=postgresql://darkroom:darkroom@localhost:5432/darkroom_test

REDIS_URL=redis://localhost:6379/0

# Minimum 32 bytes, enforced at boot. Generate: openssl rand -hex 32
JWT_SECRET=dev-only-secret-do-not-use-in-production-0000000000
CURSOR_SECRET=dev-only-cursor-secret-do-not-use-in-prod-000000000
IP_HASH_SALT=dev-only-ip-salt-change-me-000000000000000000000000

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

CORS_ORIGINS=http://localhost:3000

# The upstream generator. Keyless by design — see architecture.md §11.
UPSTREAM_BASE_URL=https://image.pollinations.ai/prompt/
UPSTREAM_TIMEOUT_SECONDS=55
UPSTREAM_TOKENS_PER_SECOND=0.7
UPSTREAM_BUCKET_CAPACITY=4

# Local filesystem in dev; S3/Blob in production.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_PUBLIC_BASE_URL=/v1/frames

MAX_QUEUE_DEPTH=500
ANON_SIGNUP_CREDITS=40
