# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
darkroom-mirror.tgz
tsconfig.tsbuildinfo
Claude outputs/
mirror-v*.tgz

# python
api/.venv/
api/.pytest_cache/
api/.mypy_cache/
api/.ruff_cache/
__pycache__/
*.py[cod]

# generated frames (content-addressed object storage, local backend)
.storage/
api/.storage/

# screenshots are regenerated by `npm run e2e`
tools/e2e-screens/
